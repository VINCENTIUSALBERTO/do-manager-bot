# ===== Required Configuration =====

# Telegram Bot Token (Dapatkan dari @BotFather)
BOT_TOKEN=

# MongoDB Connection URI (Pastikan nama database sudah disertakan)
MONGODB_URI=mongodb://localhost:27017/do-manager-bot

# 32-byte hex key untuk enkripsi AES-256-GCM token DigitalOcean.
# Generate menggunakan command: openssl rand -hex 32
ENCRYPTION_KEY=

# ===== Optional Configuration =====

# Daftar ID Telegram Administrator (dipisahkan dengan koma jika lebih dari satu)
# Admin memiliki akses penuh ke Dashboard Admin (/admin), penyesuaian limit, dan broadcast.
ADMIN_USER_IDS=

# Daftar ID Telegram yang diizinkan menggunakan bot (dipisahkan dengan koma).
# Kosongkan atau hapus baris ini untuk membiarkan bot dapat digunakan secara umum (publik).
ALLOWED_USER_IDS=

# Log Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Environment: development | production
NODE_ENV=development

# Jadwal Cron untuk pengecekan VPS kedaluwarsa (Default: setiap 1 menit)
EXPIRY_CRON=*/1 * * * *
