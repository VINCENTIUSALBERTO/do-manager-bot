# ===== Required =====

# Telegram bot token from @BotFather
BOT_TOKEN=

# MongoDB Atlas connection string (must include database name)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/do-manager-bot

# 32-byte hex master key for AES-256-GCM encryption of stored DO API tokens.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=

# ===== Optional =====

# Comma separated list of Telegram numeric user IDs that are allowed to use
# the bot. Leave empty to allow everyone (NOT recommended in production).
ALLOWED_USER_IDS=

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "production" to disable pino-pretty rendering
NODE_ENV=development

# Cron schedule for the VPS expiry sweeper. Defaults to every minute.
EXPIRY_CRON=*/1 * * * *
